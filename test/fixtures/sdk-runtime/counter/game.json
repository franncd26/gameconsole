{
  "manifestVersion": 1,
  "sdkVersion": "1.0",
  "id": "sdk-counter",
  "name": "Contador de prueba",
  "version": "1.0.0",
  "description": "Fixture unitario sin UI jugable ni servicios.",
  "category": "example",
  "entrypoints": { "server": "server.mjs", "web": "index.html" },
  "capabilities": { "pause": false, "resume": false, "multipleInstances": true, "ai": false },
  "players": { "min": 1, "max": 2 },
  "options": [
    { "id": "initial", "label": "Inicio", "type": "integer", "min": 0, "max": 10, "default": 0 },
    { "id": "size", "label": "Tamaño", "type": "integer", "values": [12, 20, 28], "default": 20 },
    { "id": "sound", "label": "Sonido", "type": "boolean", "default": false },
    { "id": "label", "label": "Etiqueta", "type": "string", "minLength": 1, "maxLength": 20, "default": "Counter" },
    { "id": "mode", "label": "Escenario unitario", "type": "enum", "values": ["normal", "throw", "event", "caught-event", "bad-start", "missing-start", "bad-player", "bad-snapshot", "bad-session"], "default": "normal" }
  ]
}
