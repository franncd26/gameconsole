{
  "manifestVersion": 1,
  "sdkVersion": "1.0",
  "id": "sdk-example",
  "name": "Ejemplo documental SDK",
  "version": "1.0.0",
  "description": "Fixture de catálogo; no es un juego instalable.",
  "category": "example",
  "entrypoints": { "server": "server.mjs", "web": "web.mjs" },
  "capabilities": { "pause": false, "resume": false, "multipleInstances": true, "ai": false },
  "players": { "min": 1, "max": 1 },
  "analytics": { "profile": "profile.json" },
  "options": [
    { "id": "difficulty", "label": "Dificultad", "type": "enum", "values": ["easy", "hard"], "default": "easy" },
    { "id": "size", "label": "Tamaño", "type": "integer", "min": 4, "max": 20, "default": 10 },
    { "id": "sound", "label": "Sonido", "type": "boolean", "default": false },
    { "id": "nickname", "label": "Alias", "type": "string", "minLength": 1, "maxLength": 24, "default": "Player" }
  ]
}
