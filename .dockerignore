# Only runtime inputs enter the GameConsole build context.
**
!package.json
!server/
!server/**
!public/
!public/**
!prolog/
!prolog/**
!plugins/
!plugins/**
# Reapply exclusions inside allowed resource trees.
**/.git
**/.deps
**/node_modules
**/evidence
**/.cache
**/.tools
**/.codex
**/.agents
**/.aws
**/target
**/.env
**/.env.*
**/credentials*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.tmp
